rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyMember(fid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }

    function familyRole(fid) {
      return get(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.role;
    }

    function isManager(fid) {
      return familyMember(fid) && (familyRole(fid) in ['owner', 'parent']);
    }

    function isTeacherOnly(fid) {
      return familyMember(fid) && familyRole(fid) == 'teacher';
    }

    function teacherOf(fid, childId) {
      return familyMember(fid) && familyRole(fid) == 'teacher' &&
        childId in get(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.get('assignedChildIds', []);
    }

    // Email outbox for the GitHub Action mailer. Written only by Cloud
    // Functions (Admin SDK bypasses rules); clients have no access.
    match /mailQueue/{id} {
      allow read, write: if false;
    }

    match /usersByEmail/{emailHash} {
      // Email -> uid index for the invite flow. Functions write, members read.
      allow get: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /families/{fid} {
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow get: if familyMember(fid);
      allow list: if signedIn();
      allow update, delete: if isManager(fid);

      match /members/{uid} {
        allow read: if familyMember(fid);
        // Bootstrap: batch-created together with the family doc, so the
        // family may not exist yet when this is evaluated.
        allow create: if signedIn() && request.auth.uid == uid &&
          request.resource.data.role == 'owner' &&
          (!exists(/databases/$(database)/documents/families/$(fid)) ||
            get(/databases/$(database)/documents/families/$(fid)).data.ownerUid == request.auth.uid);
        // Later role changes go through the inviteMember Function, but
        // managers may adjust child assignments directly.
        allow update: if isManager(fid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['assignedChildIds']);
        allow delete: if false;
      }

      match /invites/{inviteId} {
        allow read: if familyMember(fid);
        // Written only by the inviteMember Function.
        allow write: if false;
      }

      match /todos/{id} {
        allow read: if familyMember(fid);
        allow create: if familyMember(fid) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if familyMember(fid) && (
          isManager(fid) ||
          resource.data.createdBy == request.auth.uid ||
          request.auth.uid in resource.data.get('assigneeUids', [])
        );
      }

      match /transactions/{id} {
        allow read: if familyMember(fid) && !isTeacherOnly(fid);
        allow create: if isManager(fid) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isManager(fid);
      }

      match /debts/{id} {
        allow read: if familyMember(fid) && !isTeacherOnly(fid);
        allow write: if isManager(fid);
      }

      match /forecasts/{id} {
        allow read: if familyMember(fid) && !isTeacherOnly(fid);
        allow write: if false; // Functions only
      }

      match /children/{cid} {
        allow read: if familyMember(fid);
        allow write: if isManager(fid);

        match /activities/{id} {
          allow read: if familyMember(fid);
          // Parents/managers + assigned teachers may log activity.
          allow create: if isManager(fid) ||
            teacherOf(fid, request.resource.data.childId);
          allow update: if isManager(fid) ||
            teacherOf(fid, resource.data.childId);
          allow delete: if isManager(fid);
        }
      }

      match /teachers/{tid} {
        allow read: if familyMember(fid);
        allow write: if isManager(fid);

        match /sessions/{sid} {
          allow read: if familyMember(fid);
          allow create: if isManager(fid) ||
            teacherOf(fid, request.resource.data.childId);
          allow update: if isManager(fid); // approval + payment status
          allow delete: if isManager(fid);
        }
      }

      match /chats/{chatId} {
        allow get: if familyMember(fid) &&
          request.auth.uid in resource.data.participantUids;
        allow list: if familyMember(fid);
        allow create: if familyMember(fid) &&
          request.auth.uid in request.resource.data.participantUids;
        allow update: if familyMember(fid) &&
          request.auth.uid in resource.data.participantUids;
        allow delete: if false;

        match /messages/{mid} {
          allow read: if familyMember(fid);
          allow create: if familyMember(fid) &&
            request.resource.data.senderUid == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }

    match /calls/{callId} {
      // Signaling docs only; media flows via the call SDK.
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantUids;
      allow update: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow delete: if false;
    }
  }
}
